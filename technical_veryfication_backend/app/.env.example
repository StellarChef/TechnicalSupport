# Skopiuj ten plik do .env w roocie projektu i uzupełnij sekrety.
# Nigdy nie commituj realnego .env do repo.

# ── Docker Compose (porty mapowane na hosta) ───────────────────────────────

# Port hosta, na którym wystawiamy backend Django (kontener nasłuchuje na 8000).
BACKEND_PORT=8000

# Port hosta, na którym wystawiamy frontend Vite (kontener nasłuchuje na 5173).
FRONTEND_PORT=5173

# Port hosta dla Postgresa. 5433 by uniknąć konfliktu z lokalnym PG na 5432.
POSTGRES_PORT=5433


# ── Django (sekrety i tryb pracy) ──────────────────────────────────────────

# Sekretny klucz Django — wymagany. Wygeneruj losowy długi ciąg dla produkcji.
DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production

# 1 = tryb deweloperski (szczegółowe błędy), 0 = produkcja.
DJANGO_DEBUG=1

# Lista hostów akceptowanych przez Django, oddzielona przecinkami.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins frontendu dla CORS, oddzielone przecinkami. Vite domyślnie na 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── PostgreSQL ─────────────────────────────────────────────────────────────

# Nazwa bazy danych tworzonej przez kontener Postgres przy pierwszym starcie.
POSTGRES_DB=technical_verification_db

# Użytkownik bazy z pełnymi uprawnieniami do POSTGRES_DB.
POSTGRES_USER=postgres

# Hasło użytkownika POSTGRES_USER. W produkcji ustaw silne i unikalne.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Host bazy widziany z backendu. W Dockerze nadpisywane na "db" przez compose.
DB_HOST=localhost

# Port bazy widziany z backendu. W Dockerze nadpisywane na 5432 przez compose.
DB_PORT=5432


# ── Frontend ───────────────────────────────────────────────────────────────

# Bazowy URL API jaki frontend wkleja do każdego fetcha (`src/api/cases.js`).
VITE_API_URL=http://localhost:8000/api


# ── OpenAI / pipeline AI ───────────────────────────────────────────────────

# Klucz API OpenAI używany przez LangChain w `prompt_service.py`.
AI_API_KEY=sk-your-openai-key-here

# Model używany przez pipeline AI. gpt-4o dokładniejszy (vision), gpt-4o-mini tańszy.
AI_MODEL=gpt-4o

# Temperatura generacji. 0.1 = deterministyczne odpowiedzi, 1.0 = kreatywne.
AI_TEMPERATURE=0.1
