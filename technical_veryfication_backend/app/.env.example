# Django Settings
# Copy this file to .env and fill in secret values for your local environment.
# Never commit the real .env file to source control.
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional, if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DB_NAME=technical_verification_db
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=5432

# API Keys (when needed)
# OPENAI_API_KEY=sk-xxx
# OTHER_API_KEY=xxx

# CORS and frontend configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
